# ======================================================================
# Git Attributes Configuration
# ======================================================================

# Force LF line endings for all text files by default
* text=auto eol=lf

# Windows batch scripts must preserve CRLF line endings
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files - Do not modify line endings
*.png binary
*.ico binary
*.db binary
*.unity3d binary
*.usm binary
*.awb binary
*.acb binary
*.whl binary
*.zip binary